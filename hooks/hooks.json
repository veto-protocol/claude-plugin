{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(transfer|send|sendTransaction|pay|payment|wire|charge|swap)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre_payment.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre_payment.py"
          }
        ]
      }
    ]
  }
}
